# Cosmos DiffusionRenderer 서빙 설정. 이미지는 serving/cosmos-diffusion-renderer/Dockerfile로 빌드한다.
IMAGE=pixel2place/cosmos-diffusion-renderer:dr-0f3e2dc
CONTAINER_NAME=pixel2place-cosmos-diffusion-renderer
# 모든 노드가 같은 가중치를 쓰도록 HF revision을 고정한다. 세 저장소 모두 gate가 없다.
INVERSE_MODEL=nvidia/Diffusion_Renderer_Inverse_Cosmos_7B
INVERSE_REVISION=41f63abccfb764b2516ff85b98af529c2662e2df
FORWARD_MODEL=nvidia/Diffusion_Renderer_Forward_Cosmos_7B
FORWARD_REVISION=7d5f9b81affa0def046cd39bf02a8ca13a011442
TOKENIZER_MODEL=nvidia/Cosmos-Tokenize1-CV8x8x8-720p
TOKENIZER_REVISION=b6af495317c76f287a4131e9299936b1533f5f9f
PORT=8200
# 서버를 띄우는 노드 목록을 가진 저장소 루트 .env의 키. 값은 공백으로 나눈 호스트명이다.
# 이 스크립트를 실행하는 노드는 ssh 없이 실행한다.
NODES_KEY=RENDERER_NODES
