# Cosmos Reasoner 서빙 설정. 비밀 값(HF_TOKEN)은 같은 디렉터리의 .env에 둔다.
IMAGE=pixel2place/cosmos-reasoner:vllm-598d511
CONTAINER_NAME=pixel2place-cosmos-reasoner
MODEL=nvidia/Cosmos3-Nano
# 모든 노드가 같은 가중치를 쓰도록 HF revision을 고정한다.
MODEL_REVISION=411f42a8fdfb8c5b2583cb8786e0938f49796eaa
# 1이면 각 노드의 HF 캐시만 쓰고 Hub에 접속하지 않는다. 캐시에 가중치가 없는 노드는 0으로 두고 HF_TOKEN을 준다.
HF_HUB_OFFLINE=1
PORT=8000
MAX_MODEL_LEN=51200
# KV cache 크기를 고정한다. 24 GiB = 약 175k token이다. MAX_MODEL_LEN 요청을 약 3.4개 동시에 처리한다.
# 고정 값이면 vLLM이 메모리를 profiling하지 않는다. 그래서 같은 노드의 생성 서버가 먼저 떠 있어도 크기가 같다.
# vLLM 전체 점유는 약 41 GiB다(가중치 16.7 GiB, CUDA graph 약 0.5 GiB 포함).
KV_CACHE_MEMORY_BYTES=25769803776
# 기동 검사용 상한이다. 기동할 때 여유 메모리가 0.40 x 119.6 GiB = 약 47.8 GiB보다 작으면 vLLM이 실패한다.
GPU_MEMORY_UTILIZATION=0.40
# 서버를 띄우는 노드 목록을 가진 저장소 루트 .env의 키. 값은 공백으로 나눈 호스트명이다.
# 이 스크립트를 실행하는 노드는 ssh 없이 실행한다.
NODES_KEY=REASONER_NODES
