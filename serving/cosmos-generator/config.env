# Cosmos 생성 서빙 설정. vLLM-Omni가 Cosmos3-Nano의 text-to-image와 image-to-video를 서빙한다.
# HF 토큰은 각 노드의 ~/.cache/huggingface/token에 둔다(serving/scripts/set-hf-token.sh).
# arm64(GB10)에서 동작을 확인한 공식 이미지를 digest로 고정한다.
IMAGE=vllm/vllm-omni@sha256:6d2630c7d637b699557573f2c3fee8df5d4d0cd718977aa22549ed6a6ef30587
CONTAINER_NAME=pixel2place-cosmos-generator
MODEL=nvidia/Cosmos3-Nano
# VLM 서버(serving/cosmos-reasoner)와 같은 revision을 쓴다.
MODEL_REVISION=411f42a8fdfb8c5b2583cb8786e0938f49796eaa
PORT=8100
# 1이면 안전 guardrail을 켠다. 토큰 계정이 nvidia/Cosmos-1.0-Guardrail gate를 승인받아야 한다(vLLM-Omni guardrail이 받는 저장소).
GUARDRAILS=1
# 생성은 대기 중 약 35 GiB, 영상 생성 중 최대 약 43 GiB를 쓴다. node-b에서는 VLM 서버(약 41 GiB)와 함께 실행한다.
# VLM의 KV cache가 고정 크기라서 두 서버의 기동 순서는 결과에 영향을 주지 않는다.
# 서버를 띄우는 노드 목록을 가진 저장소 루트 .env의 키. 값은 공백으로 나눈 호스트명이다.
NODES_KEY=GENERATOR_NODES
