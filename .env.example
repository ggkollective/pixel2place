# Cosmos Reasoner server (OpenAI-compatible API). Replace node-b with the hostname of the Cosmos Reasoner server.
REASONER_BASE_URL=http://node-b:8000/v1
COSMOS_REASONER_MODEL=nvidia/Cosmos3-Nano
# Set this value only if the server checks the key.
REASONER_API_KEY=
REASONER_TIMEOUT_S=900
REASONER_MAX_RETRIES=1
REASONER_MAX_TOKENS=4096

# Cosmos generator server (vLLM-Omni). Replace node-a with the hostname of the image and video server.
GENERATOR_BASE_URL=http://node-a:8100/v1
COSMOS_GENERATOR_MODEL=nvidia/Cosmos3-Nano
GENERATOR_TIMEOUT_S=900

# Nebius Token Factory access. These settings are separate from the Cosmos settings.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_MODEL=nvidia/Nemotron-3_5-Lightning
NEMOTRON_TIMEOUT_S=120
NEMOTRON_MAX_TOKENS=1024

# Nebius Serverless Job (jobs/isaac-bench/scripts). These settings are separate from the Token Factory settings.
# The bucket contains the input and the output of the job. Put the bucket in the region of the job.
# Put the access key in this profile of ~/.aws.
NEBIUS_JOB_BUCKET=
NEBIUS_S3_PROFILE=nebius
# ID of the project that makes the job. If the value is empty, the default project of the nebius CLI profile applies.
NEBIUS_JOB_PROJECT_ID=

# Isaac Sim release directory (sim/ scripts)
ISAAC_SIM_PATH=/path/to/IsaacSim/_build/linux-aarch64/release

# Nodes where the scripts in serving/*/scripts start the server containers. Divide the hostnames with a space.
# The scripts run locally on the node that runs them. The scripts connect to the other nodes with ssh.
REASONER_NODES="node-b"
GENERATOR_NODES="node-a node-b"
RENDERER_NODES="node-a node-b"

# IPv4 address on which the demo web server (demo-serve) listens. Do not leave the value empty.
# If you remove the line, the address is 127.0.0.1.
# For access from other devices, set the private network address of the server node.
DEMO_HOST=127.0.0.1
